# Copy to .env and fill in the keys you have. Never commit .env.
# The tool tries providers in LLM_PROVIDERS order and fails over automatically
# (rate limit, timeout, retired model, bad key). With no key at all it runs rule-based.

LLM_PROVIDERS=claude,gemini

# Claude (official Anthropic SDK) - key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODELS=claude-opus-5-5
CLAUDE_EFFORT=medium

# Gemini - free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest
GEMINI_MIN_GAP_S=4

# Optional: any other OpenAI-compatible API (Groq, OpenRouter, an internal endpoint)
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODELS=llama-3.3-70b-versatile
# then add it to LLM_PROVIDERS, e.g. claude,gemini,openai_compat
