{"ad_id": "1873500048281666", "whisper_model": "small", "duration_s": 543.67, "head_segments": [{"start": 0.0, "end": 1.54, "text": "Mrs. Valeri didn't tell you?", "words": [{"w": " Mrs.", "s": 0.0, "e": 0.32}, {"w": " Valeri", "s": 0.58, "e": 0.78}, {"w": " didn't", "s": 0.78, "e": 1.12}, {"w": " tell", "s": 1.12, "e": 1.32}, {"w": " you?", "s": 1.32, "e": 1.54}]}, {"start": 2.42, "end": 4.4, "text": "Her site was restored seven days ago.", "words": [{"w": " Her", "s": 2.42, "e": 2.54}, {"w": " site", "s": 2.54, "e": 2.8}, {"w": " was", "s": 2.8, "e": 2.98}, {"w": " restored", "s": 2.98, "e": 3.42}, {"w": " seven", "s": 3.42, "e": 3.8}, {"w": " days", "s": 3.8, "e": 4.08}, {"w": " ago.", "s": 4.08, "e": 4.4}]}, {"start": 5.32, "end": 6.72, "text": "Our team finished the treatment.", "words": [{"w": " Our", "s": 5.32, "e": 5.48}, {"w": " team", "s": 5.48, "e": 5.72}, {"w": " finished", "s": 5.72, "e": 6.16}, {"w": " the", "s": 6.16, "e": 6.38}, {"w": " treatment.", "s": 6.38, "e": 6.72}]}, {"start": 7.58, "end": 8.86, "text": "She could see everything again.", "words": [{"w": " She", "s": 7.58, "e": 7.78}, {"w": " could", "s": 7.78, "e": 7.94}, {"w": " see", "s": 7.94, "e": 8.12}, {"w": " everything", "s": 8.12, "e": 8.48}, {"w": " again.", "s": 8.48, "e": 8.86}]}, {"start": 9.28, "end": 11.0, "text": "No. No way.", "words": [{"w": " No.", "s": 9.28, "e": 9.52}, {"w": " No", "s": 10.26, "e": 10.74}, {"w": " way.", "s": 10.74, "e": 11.0}]}, {"start": 12.08, "end": 14.16, "text": "She was so excited that day.", "words": [{"w": " She", "s": 12.08, "e": 12.72}, {"w": " was", "s": 12.72, "e": 12.86}, {"w": " so", "s": 12.86, "e": 13.1}, {"w": " excited", "s": 13.1, "e": 13.54}, {"w": " that", "s": 13.54, "e": 13.82}, {"w": " day.", "s": 13.82, "e": 14.16}]}], "language": "en", "language_prob": 0.972, "tail_segments": [{"start": 523.67, "end": 524.95, "text": "So you don't have to act like this.", "words": [{"w": " So", "s": 523.67, "e": 523.73}, {"w": " you", "s": 523.73, "e": 523.85}, {"w": " don't", "s": 523.85, "e": 524.03}, {"w": " have", "s": 524.03, "e": 524.15}, {"w": " to", "s": 524.15, "e": 524.29}, {"w": " act", "s": 524.29, "e": 524.47}, {"w": " like", "s": 524.47, "e": 524.63}, {"w": " this.", "s": 524.63, "e": 524.95}]}, {"start": 525.85, "end": 527.15, "text": "Stop humiliating yourself.", "words": [{"w": " Stop", "s": 525.85, "e": 526.31}, {"w": " humiliating", "s": 526.31, "e": 526.77}, {"w": " yourself.", "s": 526.77, "e": 527.15}]}, {"start": 527.77, "end": 529.91, "text": "Whatever we had ended three years ago.", "words": [{"w": " Whatever", "s": 527.77, "e": 528.01}, {"w": " we", "s": 528.01, "e": 528.33}, {"w": " had", "s": 528.33, "e": 528.61}, {"w": " ended", "s": 528.61, "e": 528.99}, {"w": " three", "s": 528.99, "e": 529.37}, {"w": " years", "s": 529.37, "e": 529.61}, {"w": " ago.", "s": 529.61, "e": 529.91}]}, {"start": 530.27, "end": 532.19, "text": "Don't touch me like I still belong to you.", "words": [{"w": " Don't", "s": 530.27, "e": 530.57}, {"w": " touch", "s": 530.57, "e": 530.83}, {"w": " me", "s": 530.83, "e": 531.03}, {"w": " like", "s": 531.03, "e": 531.19}, {"w": " I", "s": 531.19, "e": 531.33}, {"w": " still", "s": 531.33, "e": 531.55}, {"w": " belong", "s": 531.55, "e": 531.85}, {"w": " to", "s": 531.85, "e": 532.07}, {"w": " you.", "s": 532.07, "e": 532.19}]}, {"start": 532.31, "end": 532.49, "text": "No.", "words": [{"w": " No.", "s": 532.31, "e": 532.49}]}, {"start": 533.09, "end": 533.41, "text": "Babe.", "words": [{"w": " Babe.", "s": 533.09, "e": 533.41}]}, {"start": 534.15, "end": 535.07, "text": "I won't accept that.", "words": [{"w": " I", "s": 534.15, "e": 534.43}, {"w": " won't", "s": 534.43, "e": 534.63}, {"w": " accept", "s": 534.63, "e": 534.83}, {"w": " that.", "s": 534.83, "e": 535.07}]}, {"start": 535.53, "end": 536.37, "text": "I can't forget you.", "words": [{"w": " I", "s": 535.53, "e": 535.67}, {"w": " can't", "s": 535.67, "e": 535.95}, {"w": " forget", "s": 535.95, "e": 536.13}, {"w": " you.", "s": 536.13, "e": 536.37}]}, {"start": 537.07, "end": 537.95, "text": "Kill me if you want.", "words": [{"w": " Kill", "s": 537.07, "e": 537.29}, {"w": " me", "s": 537.29, "e": 537.47}, {"w": " if", "s": 537.47, "e": 537.61}, {"w": " you", "s": 537.61, "e": 537.71}, {"w": " want.", "s": 537.71, "e": 537.95}]}, {"start": 538.19, "end": 539.31, "text": "But don't push me away.", "words": [{"w": " But", "s": 538.19, "e": 538.33}, {"w": " don't", "s": 538.33, "e": 538.65}, {"w": " push", "s": 538.65, "e": 538.81}, {"w": " me", "s": 538.81, "e": 539.03}, {"w": " away.", "s": 539.03, "e": 539.31}]}, {"start": 539.43, "end": 541.51, "text": "He came toward me again and tried to kiss me.", "words": [{"w": " He", "s": 539.43, "e": 539.53}, {"w": " came", "s": 539.53, "e": 539.73}, {"w": " toward", "s": 539.73, "e": 539.97}, {"w": " me", "s": 539.97, "e": 540.25}, {"w": " again", "s": 540.25, "e": 540.49}, {"w": " and", "s": 540.49, "e": 540.67}, {"w": " tried", "s": 540.67, "e": 540.91}, {"w": " to", "s": 540.91, "e": 541.07}, {"w": " kiss", "s": 541.07, "e": 541.27}, {"w": " me.", "s": 541.27, "e": 541.51}]}, {"start": 541.67, "end": 543.57, "text": "I could not bear it anymore and slapped him.", "words": [{"w": " I", "s": 541.67, "e": 541.75}, {"w": " could", "s": 541.75, "e": 541.91}, {"w": " not", "s": 541.91, "e": 542.11}, {"w": " bear", "s": 542.11, "e": 542.35}, {"w": " it", "s": 542.35, "e": 542.51}, {"w": " anymore", "s": 542.51, "e": 542.87}, {"w": " and", "s": 542.87, "e": 543.05}, {"w": " slapped", "s": 543.05, "e": 543.29}, {"w": " him.", "s": 543.29, "e": 543.57}]}], "status": "ok", "secs": 45.5}