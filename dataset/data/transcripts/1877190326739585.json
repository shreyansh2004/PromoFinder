{"ad_id": "1877190326739585", "whisper_model": "small", "duration_s": 928.72, "head_segments": [{"start": 0.0, "end": 1.98, "text": "I'm also the father of your child!", "words": [{"w": " I'm", "s": 0.0, "e": 0.18}, {"w": " also", "s": 0.18, "e": 0.48}, {"w": " the", "s": 0.48, "e": 0.66}, {"w": " father", "s": 0.66, "e": 1.0}, {"w": " of", "s": 1.0, "e": 1.28}, {"w": " your", "s": 1.28, "e": 1.4}, {"w": " child!", "s": 1.4, "e": 1.98}]}, {"start": 2.3, "end": 4.08, "text": "Zoe kicked him away without hesitation.", "words": [{"w": " Zoe", "s": 2.3, "e": 2.54}, {"w": " kicked", "s": 2.54, "e": 2.84}, {"w": " him", "s": 2.84, "e": 3.02}, {"w": " away", "s": 3.02, "e": 3.26}, {"w": " without", "s": 3.26, "e": 3.48}, {"w": " hesitation.", "s": 3.48, "e": 4.08}]}, {"start": 5.28, "end": 9.1, "text": "Get lost. The only man who will ever be my husband is Henry.", "words": [{"w": " Get", "s": 5.28, "e": 5.8}, {"w": " lost.", "s": 5.8, "e": 6.22}, {"w": " The", "s": 6.7, "e": 6.78}, {"w": " only", "s": 6.78, "e": 7.02}, {"w": " man", "s": 7.02, "e": 7.28}, {"w": " who", "s": 7.28, "e": 7.42}, {"w": " will", "s": 7.42, "e": 7.52}, {"w": " ever", "s": 7.52, "e": 7.68}, {"w": " be", "s": 7.68, "e": 7.88}, {"w": " my", "s": 7.88, "e": 8.04}, {"w": " husband", "s": 8.04, "e": 8.42}, {"w": " is", "s": 8.42, "e": 8.76}, {"w": " Henry.", "s": 8.76, "e": 9.1}]}, {"start": 10.7, "end": 14.64, "text": "As for this child, just pretend it never existed.", "words": [{"w": " As", "s": 10.7, "e": 11.1}, {"w": " for", "s": 11.1, "e": 11.32}, {"w": " this", "s": 11.32, "e": 11.5}, {"w": " child,", "s": 11.5, "e": 11.96}, {"w": " just", "s": 13.08, "e": 13.32}, {"w": " pretend", "s": 13.32, "e": 13.66}, {"w": " it", "s": 13.66, "e": 13.86}, {"w": " never", "s": 13.86, "e": 14.06}, {"w": " existed.", "s": 14.06, "e": 14.64}]}], "language": "en", "language_prob": 0.985, "tail_segments": [{"start": 908.72, "end": 911.3, "text": "You're the one who sent him to the auction block and prison!", "wo