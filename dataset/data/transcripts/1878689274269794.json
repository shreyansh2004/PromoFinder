{"ad_id": "1878689274269794", "whisper_model": "small", "duration_s": 482.28, "head_segments": [{"start": 0.0, "end": 1.38, "text": "Stop embarrassing yourself.", "words": [{"w": " Stop", "s": 0.0, "e": 0.3}, {"w": " embarrassing", "s": 0.3, "e": 0.84}, {"w": " yourself.", "s": 0.84, "e": 1.38}]}, {"start": 1.62, "end": 3.44, "text": "The suffocating feeling got worse.", "words": [{"w": " The", "s": 1.62, "e": 1.7}, {"w": " suffocating", "s": 1.7, "e": 2.26}, {"w": " feeling", "s": 2.26, "e": 2.68}, {"w": " got", "s": 2.68, "e": 3.06}, {"w": " worse.", "s": 3.06, "e": 3.44}]}, {"start": 3.7, "end": 5.56, "text": "My lungs felt like they were about to burst.", "words": [{"w": " My", "s": 3.7, "e": 3.78}, {"w": " lungs", "s": 3.78, "e": 4.14}, {"w": " felt", "s": 4.14, "e": 4.38}, {"w": " like", "s": 4.38, "e": 4.56}, {"w": " they", "s": 4.56, "e": 4.7}, {"w": " were", "s": 4.7, "e": 4.84}, {"w": " about", "s": 4.84, "e": 5.06}, {"w": " to", "s": 5.06, "e": 5.24}, {"w": " burst.", "s": 5.24, "e": 5.56}]}, {"start": 6.16, "end": 9.22, "text": "Soon, I could not even move my mouth to beg for help.", "words": [{"w": " Soon,", "s": 6.16, "e": 6.42}, {"w": " I", "s": 6.74, "e": 6.82}, {"w": " could", "s": 6.82, "e": 6.98}, {"w": " not", "s": 6.98, "e": 7.22}, {"w": " even", "s": 7.22, "e": 7.5}, {"w": " move", "s": 7.5, "e": 7.74}, {"w": " my", "s": 7.74, "e": 7.98}, {"w": " mouth", "s": 7.98, "e": 8.28}, {"w": " to", "s": 8.28, "e": 8.52}, {"w": " beg", "s": 8.52, "e": 8.72}, {"w": " for", "s": 8.72, "e": 8.92}, {"w": " help.", "s": 8.92, "e": 9.22}]}, {"start": 9.58, "end": 11.92, "text": "Ryan looked at me and let out a cold laugh.", "words": [{"w": " Ryan", "s": 9.58, "e": 9.86}, {"w": " looked", "s": 9.86, "e": 10.12}, {"w": " at", "s": 10.12, "e": 10.32}, {"w": " me", "s": 10.32, "e": 10.5}, {"w": " and", "s": 10.5, "e": 10.74}, {"w": " let", "s": 10.74, "e": 10.92}, {"w": " out", "s": 10.92, "e": 11.12}, {"w": " a", "s": 11.12, "e": 11.26}, {"w": " cold", "s": 11.26